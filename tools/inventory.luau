--!strict
-- Content inventory, DERIVED from source (AGENT_LOOP v2). Run from the project
-- root:   lune run tools/inventory          (rewrites CONTENT.md, keeps History)
--         lune run tools/inventory row R140  (also appends a history row)
-- Nothing here is hand-counted: every number comes from a definition the game
-- itself reads, so the file cannot drift from the build.

local fs = require("@lune/fs")
local process = require("@lune/process")

local Harness = require("../tests/harness")

local rt = Harness.build()
local Round = rt.require(rt.systems.Round)
local Config = rt.require(rt.shared.Config)

-- GAME.md's roster: one comprehension rule each. An entity counts as built when
-- its module exists in src/server/systems.
local ROSTER = { "Operator", "PartyLine", "Stenographer", "Supervisor", "Apprentice", "Echo", "Translator" }

local function countKeys(t: any): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

local pool = Round.dealSecrets(99)
local plainWords = 0
for _, secret in pool do
	plainWords += #secret.plain
end
local stationConcepts: { [string]: boolean } = {}
for _, station in Round.STATIONS do
	stationConcepts[station.concept] = true
end
local entities = 0
local builtNames = {}
for _, name in ROSTER do
	if fs.isFile(`src/server/systems/{name}.luau`) then
		entities += 1
		table.insert(builtNames, name)
	end
end
local outcomes = 0
local lifecycle = fs.readFile("src/server/systems/Lifecycle.luau")
for _ in string.gmatch(lifecycle, "export type Outcome = ([^\n]+)") do
	outcomes = select(2, string.gsub(string.match(lifecycle, "export type Outcome = ([^\n]+)") or "", '"', "")) // 2
end
local world = fs.readFile("src/server/systems/World.luau")
local interactables = select(2, string.gsub(world, "station%(", "")) - 1 -- minus the function's own definition

local axes = {
	{ "stations (objectives a round deals)", #Round.STATIONS, 5, "Round.STATIONS" },
	{ "concepts with a station", countKeys(stationConcepts), 5, "Round.STATIONS[].concept" },
	{ "secret concepts the Operator listens for", #pool, 8, "Round.dealSecrets pool" },
	{ "plain giveaway terms", plainWords, 80, "sum of secret.plain" },
	{ "rooms", #Config.Rooms, 5, "Config.Rooms" },
	{ "world interactables (prompts)", interactables, 8, "station(...) calls in World" },
	{
		"entities built (" .. table.concat(builtNames, ", ") .. ")",
		entities,
		4,
		"GAME.md roster vs src/server/systems",
	},
	{ "Operator lines", countKeys(Round.LINES), 16, "Round.LINES" },
	{ "round outcomes", outcomes, 3, "Lifecycle Outcome type" },
	{ "round phases / variants", 1, 4, "one phase today: work the stations (GAME.md names 4)" },
}

local out = {
	"# CONTENT.md",
	"",
	"Generated by `lune run tools/inventory`. Do not edit the table by hand.",
	"Targets come from VISION.md.",
	"",
	"| axis | now | target | derived from |",
	"|---|---|---|---|",
}
local summary = {}
for _, a in axes do
	table.insert(out, `| {a[1]} | {a[2]} | {a[3]} | {a[4]} |`)
	table.insert(summary, tostring(a[2]))
end

local history =
	"## History\n\n| round | stations | concepts w/ station | concepts | plain terms | rooms | interactables | entities | lines | outcomes | phases |\n|---|---|---|---|---|---|---|---|---|---|---|\n"
if fs.isFile("CONTENT.md") then
	local existing = string.gsub(fs.readFile("CONTENT.md"), "\r\n", "\n")
	local at = string.find(existing, "## History\n", 1, true)
	if at then
		history = string.sub(existing, at)
	end
end
if process.args[1] == "row" and process.args[2] then
	if string.sub(history, -1) ~= "\n" then
		history ..= "\n"
	end
	history ..= `| {process.args[2]} | {table.concat(summary, " | ")} |\n`
end
table.insert(out, "")
fs.writeFile("CONTENT.md", table.concat(out, "\n") .. "\n" .. history)
print(table.concat(out, "\n"))
